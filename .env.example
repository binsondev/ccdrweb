# Optional. When set, Ask CoreExtract calls Gemini.
# Without it, questions are mapped locally and the customer grid still updates.
# Copy to frontend/.env. Do not put a real key in this file.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# AG-UI agent port. The Angular dev server proxies /ag-ui here.
PORT=4318
